{
  "manifest_version": 2,
  "name": "Flick — Aegis OTP",
  "version": "1.0.1",
  "description": "Auto-fill OTP codes from your Aegis vault backup",
  "browser_specific_settings": {
    "gecko": {
      "id": "{d4e5f6a7-b8c9-4d0e-a1f2-3b4c5d6e7f80}",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "scripts": ["lib/scrypt.js", "crypto.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
